{
  "name": "dsh-webstack-verticals",
  "version": "0.2.0",
  "description": "WebStack Verticals (网栈·垂): experimental vertical-channel satellite — compliant credential-free X fallback via site: search plus official oEmbed enrichment; off by default, user opt-in only",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "webstack",
    "vertical-search",
    "oembed"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/dsh-webstack.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "compatible": ">=0.1.5-rc.2 <0.2.0",
    "autoApprove": true,
    "capabilities": [
      {
        "type": "service",
        "service": {
          "name": "dsh-webstack-verticals/x-vertical",
          "factory": "./lib/index.js",
          "singleton": true
        }
      }
    ],
    "sandbox": {
      "type": "inline",
      "resources": {
        "memoryLimitMb": 256,
        "cpuLimit": 50,
        "timeoutMs": 30000,
        "maxOutputBytes": 10000
      },
      "filesystem": {
        "access": "readonly",
        "allowedPaths": [],
        "deniedPatterns": []
      },
      "network": {
        "access": "external",
        "allowedHosts": [
          "publish.twitter.com"
        ],
        "deniedHosts": [],
        "allowLocal": false
      },
      "environment": {
        "whitelist": [],
        "blacklist": [],
        "clear": false
      },
      "process": {
        "spawn": false,
        "exec": false,
        "allowedCommands": []
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-webstack": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "dsh-webstack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
