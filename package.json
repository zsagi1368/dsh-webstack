{
  "name": "dsh-webstack-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the DSH WebStack plugin family: core plugin plus planned satellite packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/dsh-webstack.git"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "lint": "pnpm -r --filter \"./packages/**\" run lint",
    "check": "pnpm -r --filter \"./packages/**\" run check"
  }
}
